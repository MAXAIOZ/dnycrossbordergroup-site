# Set in Cloudflare Pages → Settings → Variables and Secrets (Production + Preview).
# Never commit real values. This file lists names only.

# Cloudflare Access (Zero Trust) — protects /admin/* and /api/admin/*
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Form delivery: the site sends enquiries from the company Gmail account via the Gmail API.
# Create an OAuth client (Desktop) in Google Cloud, authorise info@ once, store the refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_TO=info@dnycrossbordergroup.com
MAIL_FROM=DNY website <info@dnycrossbordergroup.com>

# Transactional email (Resend) — buyer confirmation + reply copies
RESEND_API_KEY=

# Business identity checks (optional; code degrades gracefully when absent)
ABN_LOOKUP_GUID=
NZBN_API_KEY=

# Bindings provided by Cloudflare Pages (not secrets, listed for reference)
# DB    — D1 database
# FILES — KV namespace

# ADMIN_DEV_BYPASS — local development only, never set in production
