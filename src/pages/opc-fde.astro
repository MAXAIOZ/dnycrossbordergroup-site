---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Definition from '../components/Definition.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import { CTA } from '../data/site';
import { techArticle, definedTerm } from '../data/schema';

const title = 'OPC + FDE Network';
const description = 'The OPC + FDE network is how DNY turns infrastructure into deployed industry solutions: OPC (Office + AI Agents) nodes, Forward Deployed Entrepreneurs, and the ANZ OPC + FDE Alliance — starting in Sydney, expanding to Auckland.';
const def = 'DNY’s deployment and delivery network: OPC nodes (Office + AI Agents) and Forward Deployed Entrepreneurs (FDE) that take AI and physical intelligence from proof of concept to real deployment.';
const crumbs = [{ name: 'OPC + FDE', href: '/opc-fde' }];
const fde = [
  { k: 'Embed', d: 'Work alongside the customer to understand processes, data and constraints.' },
  { k: 'Shape', d: 'Define a use case with measurable outcomes and a governance plan.' },
  { k: 'Prove', d: 'Build a pilot on DNY infrastructure — AI, physical devices or both.' },
  { k: 'Deploy', d: 'Harden for production with security, monitoring and support.' },
  { k: 'Scale or spin out', d: 'Extend across sites, or incubate a repeatable solution as a new venture.' },
];
---
<Base {title} {description} breadcrumbs={crumbs} schema={[techArticle('OPC + FDE: from infrastructure to real deployment', description, '/opc-fde', ['OPC', 'FDE', 'ANZ OPC + FDE Alliance']), definedTerm('OPC (Office + AI Agents)', 'A local business node that combines a workspace, AI agent capabilities and market connections so small teams can deliver like larger organisations.', '/opc-fde#opc'), definedTerm('FDE (Forward Deployed Entrepreneur)', 'A delivery role that works directly on a real customer problem in the field, taking a solution from proof of concept to deployment.', '/opc-fde#fde')]}>
<PageHero badge="OPC + FDE" title="OPC + FDE: from infrastructure to real deployment" {crumbs}
  lead="Infrastructure only matters when it reaches real customers. The OPC + FDE network brings together small teams, AI agents, industry specialists and enterprise customers to turn DNY infrastructure into solutions that are actually deployed."
  primary={CTA.partner} secondary={CTA.brief}>
  <Definition term="OPC + FDE Network" def={def} />
</PageHero>

<section class="section" id="opc" aria-labelledby="opc-h">
  <div class="container">
    <SectionHead kicker="OPC = Office + AI Agents" id="opc-h" title="Local nodes where small teams deliver like large ones"
      lead="An OPC is a local business node — not a conventional co-working space. It gives a small team four things in one place." />
    <div class="tiles t4 stagger reveal">
      <div class="tile"><span class="t-k">Space</span><h3>Business base</h3><p>A professional base and collaboration space.</p></div>
      <div class="tile"><span class="t-k">Agents</span><h3>AI agent capability</h3><p>Access to DNY infrastructure and governed agents.</p></div>
      <div class="tile"><span class="t-k">Market</span><h3>Market connections</h3><p>Enterprise customers, suppliers and partners.</p></div>
      <div class="tile"><span class="t-k">Talent</span><h3>Project talent pool</h3><p>Universities, developers, founders and specialists.</p></div>
    </div>
  </div>
</section>

<section class="section dark" id="fde" aria-labelledby="fde-h">
  <div class="container">
    <SectionHead kicker="FDE = Forward Deployed Entrepreneur" id="fde-h" title="Delivery that starts with the customer’s problem"
      lead="FDEs sit with real customers, understand real constraints, and use DNY infrastructure to deliver solutions that get deployed." />
    <div class="layers reveal">
      {fde.map((s, i) => <div class="layer"><div class="layer-idx">{i + 1}</div><div class="layer-body"><h3>{s.k}</h3><p>{s.d}</p></div></div>)}
    </div>
    <p class="src-note reveal" id="incubation" style="margin-top:16px;">When a solution repeats across customers, it is incubated inside the network and can become an independent <a href="/ventures" style="color:var(--gold-lt)">venture</a> on DNY infrastructure.</p>
  </div>
</section>

<section class="section" id="alliance" aria-labelledby="al-h">
  <div class="container split">
    <div class="reveal-l">
      <span class="kicker">ANZ OPC + FDE Alliance</span>
      <h2 id="al-h" class="h2-sm">The membership organisation behind the network</h2>
      <div class="prose" style="margin-top:16px;">
        <p>The <strong>ANZ OPC + FDE Alliance</strong> organises OPC entrepreneurs across Australia and New Zealand into a membership network, with FDE delivery capability built into member benefits rather than offered as a separate tier.</p>
        <p>Members get access to the network’s nodes, customers, training and DNY infrastructure; DNY gets a delivery capacity that scales with real demand.</p>
      </div>
    </div>
    <div class="reveal-r" id="anz">
      <div class="sep-box">
        <h3 class="h4">Sydney first, Auckland next</h3>
        <p>Sydney is the first node, alongside DNY’s headquarters. Auckland is the expansion direction for New Zealand. Membership and partnership are established through documented agreements.</p>
      </div>
    </div>
  </div>
</section>

<FAQ groups={['opcfde']} title="OPC + FDE — common questions" dark />

<CTABand title="Deliver real projects with the network" primary={CTA.partner} secondary={CTA.brief} />
</Base>
