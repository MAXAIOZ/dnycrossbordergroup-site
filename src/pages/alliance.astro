---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import body from '../legacy/alliance.html?raw';
import meta from '../legacy/meta.json';
const m = meta['alliance'];
const crumbs = [{ name: 'Australian Open Source AI Alliance', href: '/alliance' }];
---
<Base title="Australian Open Source AI Alliance" description="The proposed Australian Open Source AI Alliance — an independent, not-for-profit ecosystem for open AI collaboration, kept legally and financially separate from DNY." breadcrumbs={crumbs}>
<PageHero badge="Ecosystem" title={m.h1} lead={m.lead} {crumbs} primary={{ label: "Partner with the Alliance", href: "/contact?type=partnership" }} secondary={{ label: "Open Source AI", href: "/open-source-ai" }} />
<Fragment set:html={body} />
<CTABand title="Talk to DNY" primary={{ label: "Partner with the Alliance", href: "/contact?type=partnership" }} secondary={{ label: 'Contact', href: '/contact' }} />
</Base>
