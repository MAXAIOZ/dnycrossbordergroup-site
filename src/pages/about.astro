---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Definition from '../components/Definition.astro';
import GroupStack from '../components/GroupStack.astro';
import FAQ from '../components/FAQ.astro';
import CTABand from '../components/CTABand.astro';
import { HIERARCHY } from '../data/architecture';
import { SITE } from '../data/site';

const title = 'About — Group Overview';
const description = 'About DNY Cross Border Group: an Australia-led technology and commercialisation group building trusted, open AI infrastructure and connecting it with the physical economy. Group structure, principles and global reach.';
const crumbs = [{ name: 'About', href: '/about' }];
const principles = [
  { k: 'Australian-led', d: 'Governance, data rules, standards adaptation and industry application grounded in Australian law, market and industry needs.' },
  { k: 'Open collaboration', d: 'Open to quality technology, models, data and research worldwide — not dependent on a single country, supplier or technology route.' },
  { k: 'Trust first', d: 'Verifiable, traceable and auditable mechanisms for data source, version, permission, update and use.' },
  { k: 'Industry first', d: 'Start from real industry projects with clear data foundations and practical value.' },
  { k: 'Standardised interfaces', d: 'APIs, data dictionaries, unified identifiers and standard structures connect platforms, systems and devices.' },
  { k: 'Clear IP', d: 'Each party keeps existing IP; new data, derived results and joint work are assigned by specific agreement.' },
];
---
<Base {title} {description} breadcrumbs={crumbs}>
<PageHero badge="Group Overview" title="About DNY Cross Border Group" {crumbs}
  lead="An Australia-led technology and commercialisation group, headquartered in Sydney, building trusted, open AI infrastructure and connecting it with the physical economy."
  primary={{ label: 'Request the Group Brief', href: '/contact?type=investment' }}
  secondary={{ label: 'Investors & Partners', href: '/investors' }}>
  <Definition term="DNY Cross Border Group" def={SITE.positioning} />
</PageHero>

<section class="section" aria-labelledby="who-h">
  <div class="container split">
    <div class="reveal-l">
      <span class="kicker">Who We Are</span>
      <h2 id="who-h">From AI platform to infrastructure group</h2>
      <div class="prose" style="margin-top:16px;">
        <p>DNY began by building the commercial layer between global open-source AI and Australian enterprise. As commercial drones, embodied robotics, OPC + FDE delivery, trusted data spaces and industry projects were added, a single-platform description no longer fitted.</p>
        <p>DNY is now organised as a <strong>group</strong>: one holding layer, two infrastructure layers — digital and physical — a delivery network, and independent ventures that build on all of them.</p>
        <p>We create value at the commercialisation layer — localisation, security, integration, operations and support — rather than by training a new foundation model.</p>
      </div>
    </div>
    <div class="reveal-r">
      <GroupStack compact />
    </div>
  </div>
</section>

<section class="section dark" aria-labelledby="h-h">
  <div class="container">
    <SectionHead kicker="Group Structure" id="h-h" title="Group → infrastructure → physical intelligence → network → ventures" />
    <div class="reveal" style="overflow-x:auto;">
      <table class="htable">
        <thead><tr><th scope="col">Level</th><th scope="col">Name</th><th scope="col">Role</th><th scope="col">Scope</th></tr></thead>
        <tbody>
          {HIERARCHY.map((h) => <tr><th scope="row">{h.level}</th><td><strong>{h.name}</strong></td><td>{h.role}</td><td>{h.scope}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="src-note reveal" style="margin-top:14px;">The structure is designed so that new independent brands — such as drone, robotics, warehousing or construction-technology companies — can be added at Layer 5 without redesigning the group.</p>
  </div>
</section>

<section class="section" aria-labelledby="pr-h">
  <div class="container">
    <SectionHead kicker="Build Principles" id="pr-h" title="How we build" />
    <div class="tiles t3 stagger reveal">
      {principles.map((p) => <div class="tile"><span class="t-k">Principle</span><h3>{p.k}</h3><p>{p.d}</p></div>)}
    </div>
  </div>
</section>

<section class="section dark" id="australia-global" aria-labelledby="ag-h">
  <div class="container split">
    <div class="reveal-l">
      <span class="kicker">Australia &amp; Global</span>
      <h2 id="ag-h">Led from Sydney, connected to the world</h2>
      <div class="prose" style="margin-top:16px;">
        <p>DNY is headquartered in Barangaroo, Sydney. The OPC + FDE network starts in Sydney, with Auckland as the expansion direction for New Zealand.</p>
        <p>Technology, models and hardware are selected on a global, multi-origin basis. Australia serves as a gateway in both directions: a structured route for suitable international technology into Australian industry, and a platform for Australian capability to reach global markets.</p>
      </div>
    </div>
    <div class="reveal-r">
      <div class="sep-box">
        <h3 class="h4">Policy alignment</h3>
        <p>Australia’s National AI Plan focuses on domestic capability, smart infrastructure, adoption, responsible practice and international engagement, with the National AI Centre supporting practical industry adoption. DNY’s focus on trusted, deployable AI in the physical economy is consistent with that direction.</p>
      </div>
      <p class="src-note" style="margin-top:14px;">Source: Australian Department of Industry, Science and Resources / National AI Centre, 2025–2026.</p>
    </div>
  </div>
</section>

<FAQ groups={['group']} title="About DNY — common questions" />

<CTABand title="Work with an accountable Australian AI group"
  primary={{ label: 'Request the Group Brief', href: '/contact?type=investment' }}
  secondary={{ label: 'Partner with DNY', href: '/contact?type=partnership' }} />
</Base>
