---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import GroupStack from '../components/GroupStack.astro';
import VentureMini from '../components/VentureMini.astro';
import CTABand from '../components/CTABand.astro';
import Arrow from '../components/Arrow.astro';
import { VENTURES, CATEGORIES } from '../data/ventures';
import { CTA } from '../data/site';
---
<Base
  title="DNY Cross Border Group | Trusted Open AI, Connected to the Physical World"
  description="DNY Cross Border Group is a Sydney-headquartered technology group, grown from cross-border trade, building trusted, open AI and physical intelligence infrastructure for Australian industry and commercialising it through nine focused ventures."
>
<section id="home" class="hero" aria-labelledby="hero-heading">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-layout">
      <div class="hero-content">
        <div class="hero-badge" aria-hidden="true"><span class="hero-badge-dot"></span>Sydney-headquartered technology group</div>
        <h1 id="hero-heading">Trusted Open AI.<br><em class="grad-text">Connected to the Physical World.</em></h1>
        <p class="hero-subtitle">DNY Cross Border Group grew from cross-border trade into a technology group that builds trusted, open AI and physical intelligence infrastructure for Australian industry — and commercialises it through nine focused ventures.</p>
        <div class="hero-actions">
          <a href={CTA.brief.href} class="btn btn-primary">{CTA.brief.label}</a>
          <a href={CTA.partner.href} class="btn btn-secondary">{CTA.partner.label}</a>
        </div>
        <div class="hero-stats">
          <div class="stat-item"><div class="stat-num">Sydney</div><div class="stat-label">Headquarters</div></div>
          <div class="stat-item"><div class="stat-num" data-count="9">9</div><div class="stat-label">Core ventures</div></div>
          <div class="stat-item"><div class="stat-num">Multi</div><div class="stat-label">Model, cloud &amp; hardware</div></div>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="globe-caption">
          <span class="globe-tag"><span class="globe-dot"></span>Trusted &middot; Open &middot; Physical</span>
          <span class="globe-hq">Sydney &middot; Australia</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 1 · Group structure -->
<section class="section" id="architecture" aria-labelledby="stack-h">
  <div class="container">
    <SectionHead kicker="How the Group Fits Together" id="stack-h" title="One group, five layers"
      lead="Each layer builds on the one below it. Every venture inherits the same trusted data, identity and audit foundation instead of rebuilding it." />
    <GroupStack />
  </div>
</section>

<!-- 2 · Two capabilities -->
<section class="section dark" aria-labelledby="cap-h">
  <div class="container">
    <SectionHead kicker="What We Build" id="cap-h" title="Two capabilities, one trust model" />
    <div class="grid-2 stagger reveal">
      <div class="big-panel">
        <span class="k">Digital</span>
        <h3>Trusted &amp; Open AI Infrastructure</h3>
        <p>Open and open-weight models, AI agents and private or hybrid deployment — multi-model, multi-cloud and licence-aware — on a foundation where data sources, permissions and AI actions can be verified.</p>
        <a href="/ai-infrastructure" class="project-link">AI Infrastructure <Arrow /></a>
      </div>
      <div class="big-panel">
        <span class="k">Physical</span>
        <h3>Physical Intelligence</h3>
        <p>The same trusted AI, connected to drones, robots, edge devices and industrial systems — so machines can perceive, decide and act, and every action can be traced to an identity and a permission.</p>
        <a href="/physical-intelligence" class="project-link">Physical Intelligence <Arrow /></a>
      </div>
    </div>
    <p class="src-note reveal" style="margin-top:20px;">Deployed through the <a href="/opc-fde" style="color:var(--gold-lt)">OPC + FDE network</a> into <a href="/industries" style="color:var(--gold-lt)">built environment, logistics, cross-border trade and enterprise</a>.</p>
  </div>
</section>

<!-- 3 · Ventures -->
<section class="section" aria-labelledby="ven-h">
  <div class="container">
    <SectionHead kicker="Ventures" id="ven-h" title="Nine ventures on shared infrastructure"
      lead="Each venture keeps its own customers and business model while reusing the group’s trusted AI and physical intelligence infrastructure." />
    {CATEGORIES.map((c) => (
      <div class="reveal cat-block">
        <div class="cat-head"><h3>{c}</h3></div>
        <div class="vmini-grid">{VENTURES.filter((v) => v.category === c).map((v) => <VentureMini v={v} />)}</div>
      </div>
    ))}
  </div>
</section>

<!-- 4 · Why Australia -->
<section class="section dark" aria-labelledby="au-h">
  <div class="container">
    <SectionHead kicker="Why Now, Why Australia" id="au-h" title="A real adoption gap in the physical economy" />
    <div class="thesis-band reveal">
      <div class="thesis-stat"><div class="ts-num">12%</div><div class="ts-label">of Australian businesses used AI in 2024&ndash;25, up from 1% in 2021&ndash;22 (ABS)</div></div>
      <div class="thesis-stat"><div class="ts-num cyan">89%</div><div class="ts-label">of organisations use some open source in their AI stack; 63% use an open model (Linux Foundation, 2025)</div></div>
      <div class="thesis-stat"><div class="ts-num">A$22b</div><div class="ts-label">annual enterprise procurement behind the Buy Australian AI Partnership (DISR, 2026)</div></div>
      <div class="thesis-stat"><div class="ts-num cyan">1%</div><div class="ts-label">reported AI use in Transport, Postal &amp; Warehousing &mdash; the physical-economy gap we target (ABS)</div></div>
    </div>
    <p class="src-note reveal" style="margin-top:18px;max-width:820px;">Sources: Australian Bureau of Statistics, <em>Characteristics of Australian Business 2024&ndash;25</em>; Linux Foundation Research, 2025; Australian Department of Industry, Science and Resources / National AI Centre, 2025&ndash;2026. Figures record whether a business reported AI use, not intensity of use.</p>
  </div>
</section>

<CTABand kicker="Work With DNY" title="Get the group brief"
  lead="Strategy, structure and ventures in one briefing — for investors, government and institutional partners."
  primary={CTA.brief} secondary={CTA.partner} />
</Base>
