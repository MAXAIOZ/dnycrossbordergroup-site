---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Catalogue from '../../components/parts/Catalogue.astro';
import BasketPill from '../../components/parts/BasketPill.astro';
import { COMPONENTS_CTA } from '../../data/components';
const crumbs = [{ name: 'Parts & Components', href: '/components' }, { name: 'Drone Components', href: '/components/drones' }];
---
<Base title="Drone Components" description="Replacement propellers, fasteners, airframe parts, passive mounts, cases and hand tools for commercial drones — matched to the model, generation and part number you specify." breadcrumbs={crumbs}>
<PageHero badge="Parts & Components" title="Drone Components" {crumbs} lead="Replacement propellers, fasteners, airframe parts, passive mounts, cases and hand tools for commercial drones — matched to the model, generation and part number you specify." primary={COMPONENTS_CTA.quote} />
<section class="section" aria-label="Catalogue">
  <div class="container">
    <Catalogue app="drone" />
    <p class="src-note" style="margin-top:28px;">Fit is confirmed for the specific model and part number you provide. Prices, stock and lead times are confirmed only in a written quote.</p>
  </div>
</section>
<BasketPill />
</Base>
