---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import ProductCard from '../../../components/parts/ProductCard.astro';
import BasketPill from '../../../components/parts/BasketPill.astro';
import { PRODUCTS, BRANDS, category, APP_LABEL, APP_PATH, STATUS, type Product } from '../../../data/components';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const c = category(p.category);
const crumbs = [{ name: 'Parts & Components', href: '/components' }, { name: APP_LABEL[p.application], href: APP_PATH[p.application] }, { name: p.name, href: `/components/products/${p.slug}` }];
const brand = p.brand ? BRANDS[p.brand] : null;
const related = PRODUCTS.filter((x) => x.category === p.category && x.id !== p.id).slice(0, 3);
---
<Base title={`${p.name} — ${APP_LABEL[p.application]}`} description={`${p.description} Request a quote from DNY Cross Border Group with your model, part number and quantity.`} breadcrumbs={crumbs}>
<PageHero badge={c.name} title={p.name} {crumbs} lead={p.description}>
  <div class="hero-actions"><button type="button" class="btn btn-primary btn-add" data-add={p.id}>Add to Enquiry</button><a href="/components/enquiry" class="btn btn-secondary">Request a Quote</a></div>
</PageHero>
{p.models && (
  <section class="section" aria-labelledby="models-h">
    <div class="container">
      <h2 id="models-h" class="h2-sm">{p.series} models</h2>
      <p class="pcard-desc" style="margin:10px 0 18px;">Model names as published by {brand?.owner}. Select a model to add it to your enquiry list.</p>
      <div class="ds-callout">
        <strong>Need the full datasheet?</strong>
        <span>Datasheets are available for every {p.brand} model on this page. Email <a href={`mailto:info@dnycrossbordergroup.com?subject=${encodeURIComponent(`${p.brand} ${p.series} datasheet request`)}`}>info@dnycrossbordergroup.com</a> with the model numbers you need and we will send them to you.</span>
      </div>
      <ul class="model-list" role="list">{p.models.map((m) => <li><button type="button" class="model-chip" data-add={p.id} data-part={m} aria-label={`Add ${p.brand} ${m} to enquiry`}><span>{m}</span><span class="model-plus" aria-hidden="true">+</span></button></li>)}</ul>
    </div>
  </section>
)}
<section class="section" aria-label="Product details">
  <div class="container split">
    <div class="reveal-l">
      <h2 class="h2-sm">What to send us</h2>
      <ul class="check-cols" style="grid-template-columns:1fr;margin-top:16px;">{p.send.map((s) => <li>{s}</li>)}</ul>
      <h2 class="h2-sm" style="margin-top:32px;">Limitations</h2>
      <ul class="check-cols" style="grid-template-columns:1fr;margin-top:16px;">{p.limits.map((s) => <li>{s}</li>)}</ul>
    </div>
    <div class="reveal-r">
      <dl class="vfacts" style="grid-template-columns:1fr;margin-top:0;">
        <div class="vfact"><dt>Reference</dt><dd>{p.id}</dd></div>
        <div class="vfact"><dt>Category</dt><dd>{c.name}</dd></div>
        {brand && <div class="vfact"><dt>Brand</dt><dd>{brand.name} ({brand.owner})</dd></div>}
        <div class="vfact"><dt>Information status</dt><dd>{STATUS.information.general}</dd></div>
        <div class="vfact"><dt>Fit status</dt><dd>{STATUS.fit['per-enquiry']}</dd></div>
        <div class="vfact"><dt>Supply status</dt><dd>{STATUS.supply['on-request']}</dd></div>
      </dl>
      {brand && <p class="src-note" style="margin-top:16px;">{brand.note}</p>}
    </div>
  </div>
</section>
{related.length > 0 && (
  <section class="section dark" aria-labelledby="rel-h">
    <div class="container">
      <h2 id="rel-h" class="h2-sm" style="margin-bottom:20px;">More in {c.name}</h2>
      <div class="pgrid">{related.map((r) => <ProductCard p={r} />)}</div>
    </div>
  </section>
)}
<BasketPill />
</Base>
