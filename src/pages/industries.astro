---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import IndustryMatrix from '../components/IndustryMatrix.astro';
import CTABand from '../components/CTABand.astro';
import { INDUSTRIES } from '../data/industries';
import { VENTURES } from '../data/ventures';
import { CTA } from '../data/site';

const title = 'Industries';
const description = 'Where DNY’s trusted AI and physical intelligence infrastructure is applied: built environment, logistics and warehousing, cross-border trade, enterprise and professional services, and future verticals.';
const crumbs = [{ name: 'Industries', href: '/industries' }];
const current = INDUSTRIES.filter((i) => !i.future);
const future = INDUSTRIES.find((i) => i.future)!;
const vname = (s: string) => VENTURES.find((v) => v.slug === s)?.name ?? s;
const extra: Record<string, { k: string; d: string }[]> = {
  'built-environment': [
    { k: 'Open building data', d: 'Materials, products, suppliers, project stages, cost, procurement and lifecycle data in one structure.' },
    { k: 'Standards mapping', d: 'Structural, fire, thermal, energy and acoustic indicators mapped between Australian and international standards.' },
    { k: 'Product library', d: 'Machine-readable product records with certifications, test reports and BIM / CAD models.' },
    { k: 'Modular & MMC', d: 'Standard modules, components and assembly rules for modular and 3D-printed construction.' },
  ],
};
const evidence: Record<string, string> = {
  'built-environment': '6% of Australian construction businesses reported AI use in 2024–25 (ABS).',
  'logistics-warehousing': '1% of Australian businesses in Transport, Postal & Warehousing reported AI use in 2024–25 (ABS).',
};
---
<Base {title} {description} breadcrumbs={crumbs}>
<PageHero badge="Industries" title="Industries: where the infrastructure is applied" {crumbs}
  lead="We start in the physical-economy sectors where Australian AI adoption is lowest and the value of trusted, deployable AI is highest — and where the group’s cross-border roots give us real operating knowledge."
  primary={CTA.partner} secondary={CTA.brief} />

<section class="section" aria-labelledby="mx-h">
  <div class="container">
    <SectionHead kicker="Industry × Capability" id="mx-h" title="Which capabilities apply where"
      lead="Core capabilities are central to the solution in that industry; supporting capabilities are used where relevant." />
    <IndustryMatrix />
  </div>
</section>

{current.map((ind, n) => (
  <section class={`section${n % 2 === 0 ? ' dark' : ''}`} id={ind.slug} aria-labelledby={`i-${ind.slug}`}>
    <div class="container">
      <div class="split">
        <div class="reveal-l">
          <span class="kicker">Industry {String(n + 1).padStart(2, '0')}</span>
          <h2 id={`i-${ind.slug}`}>{ind.name}</h2>
          <p class="lead" style="margin-top:14px;">{ind.description}</p>
          {evidence[ind.slug] && <p class="src-note" style="margin-top:12px;">{evidence[ind.slug]}</p>}
        </div>
        <div class="reveal-r">
          <ul class="check-cols" style="grid-template-columns:1fr;">{ind.useCases.map((u) => <li>{u}</li>)}</ul>
          {ind.ventures.length > 0 && <p class="src-note" style="margin-top:18px;">Ventures: {ind.ventures.map((s, i) => <>{i > 0 && ' · '}<a href={`/ventures/${s}`} style="color:var(--gold-lt)">{vname(s)}</a></>)}</p>}
        </div>
      </div>
      {extra[ind.slug] && (
        <div class="tiles t4 mt-28 stagger reveal">{extra[ind.slug].map((e) => <div class="tile"><span class="t-k">Data foundation</span><h3>{e.k}</h3><p>{e.d}</p></div>)}</div>
      )}
    </div>
  </section>
))}

<section class="section" id="future" aria-labelledby="fut-h">
  <div class="container">
    <SectionHead kicker="Future Expansion" id="fut-h" title="Future verticals" lead={future.description} />
    <div class="tiles t4 stagger reveal">
      {future.useCases.map((u) => { const [k, d] = u.split(' — '); return <div class="tile"><span class="t-k">Future expansion</span><h3>{k}</h3><p>{d}</p></div>; })}
    </div>
    <p class="src-note reveal" style="margin-top:18px;">Future verticals describe intended expansion directions only, not current operations.</p>
  </div>
</section>

<CTABand title="Bring your industry to trusted, open AI" primary={CTA.partner} secondary={CTA.brief} />
</Base>
