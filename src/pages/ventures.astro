---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import VentureGrid from '../components/VentureGrid.astro';
import CTABand from '../components/CTABand.astro';
import { VENTURES, STATUS_DEFS, type Status } from '../data/ventures';

const title = 'Applied Ventures';
const description = `DNY Cross Border Group’s ${VENTURES.length} applied ventures — drones, robotics, logistics, construction, trade, data and media — each with its layer, industry, status and relationship to DNY infrastructure.`;
const crumbs = [{ name: 'Ventures', href: '/ventures' }];
const list = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'DNY Applied Ventures',
  numberOfItems: VENTURES.length,
  itemListElement: VENTURES.map((v, i) => ({ '@type': 'ListItem', position: i + 1, name: v.name, url: `https://dnycrossbordergroup.com/ventures/${v.slug}` })),
};
---
<Base {title} {description} breadcrumbs={crumbs} schema={[list]}>
<PageHero badge="Layer 5 · Applied Ventures & Industry Projects" title="Applied Ventures: focused businesses on shared infrastructure" {crumbs}
  lead="Ventures are independent projects and companies with their own products, customers and business models. Each one reuses the group’s trusted AI infrastructure, physical intelligence layer and delivery network — so new ventures can be added without redesigning the group."
  primary={{ label: 'Partner on a venture', href: '/contact?type=partnership' }}
  secondary={{ label: 'Investor briefing', href: '/contact?type=investment' }} />

<section class="section" aria-labelledby="pf-h">
  <div class="container">
    <SectionHead kicker="Portfolio" id="pf-h" title="Filter by category, industry, technology or status" />
    <VentureGrid />
  </div>
</section>

<section class="section dark" aria-labelledby="st-h">
  <div class="container">
    <SectionHead kicker="Status Labels" id="st-h" title="What each status means" lead="Every venture carries one status label so that stage is never overstated." />
    <dl class="glossary reveal">
      {(Object.keys(STATUS_DEFS) as Status[]).map((s) => <div><dt>{s}</dt><dd>{STATUS_DEFS[s]}</dd></div>)}
    </dl>
  </div>
</section>

<CTABand title="Want the brief on a single venture?"
  primary={{ label: 'Request a venture briefing', href: '/contact?type=investment' }}
  secondary={{ label: 'Partnership enquiry', href: '/contact?type=partnership' }} />
</Base>
