---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import VentureCard from '../../components/VentureCard.astro';
import SectionHead from '../../components/SectionHead.astro';
import CTABand from '../../components/CTABand.astro';
import FAQ from '../../components/FAQ.astro';
import { FAQS } from '../../data/faqs';
import { VENTURES, STATUS_DEFS, type Venture } from '../../data/ventures';
import { CTA } from '../../data/site';
import meta from '../../legacy/meta.json';

const bodies = import.meta.glob('../../legacy/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;

export function getStaticPaths() {
  return VENTURES.map((v) => ({ params: { slug: v.slug }, props: { v } }));
}
const { v } = Astro.props as { v: Venture };
const key = v.body ?? v.slug;
const m = (meta as Record<string, { h1?: string; lead?: string; description?: string }>)[key] ?? {};
const body = (bodies[`../../legacy/${key}.html`] ?? '').replaceAll('{{name}}', v.name);
const crumbs = [{ name: 'Ventures', href: '/ventures' }, { name: v.name, href: `/ventures/${v.slug}` }];
const description = `${v.name}: ${v.short} Status: ${v.status}.`;
const related = VENTURES.filter((x) => x.slug !== v.slug && x.category === v.category).slice(0, 3);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: v.name,
  description: v.short,
  about: { '@type': 'Thing', name: v.name, description: v.short },
  isPartOf: { '@id': 'https://dnycrossbordergroup.com/#website' },
  publisher: { '@id': 'https://dnycrossbordergroup.com/#organization' },
  keywords: [...v.capabilities, ...v.tech, ...v.industries].join(', '),
};
---
<Base title={v.name} {description} breadcrumbs={crumbs} schema={[schema]}>
<PageHero badge={`Venture · ${v.category}`} title={v.name} lead={m.lead || v.short} {crumbs}
  primary={v.site ? { label: v.site.label, href: v.site.url } : CTA.partner}
  secondary={v.site ? CTA.partner : CTA.brief}>
  <dl class="vfacts">
    <div class="vfact"><dt>Status</dt><dd><StatusBadge status={v.status} />{v.statusNote && <span class="line-badge" style="margin-left:8px;white-space:nowrap;">{v.statusNote}</span>}<span class="sr-only">: {STATUS_DEFS[v.status]}</span></dd></div>
    <div class="vfact"><dt>Builds on</dt><dd>{v.builtOn}</dd></div>
    <div class="vfact"><dt>Industry</dt><dd>{v.industries.join(', ')}</dd></div>
    <div class="vfact"><dt>Core capabilities</dt><dd>{v.capabilities.join(' · ')}</dd></div>
  </dl>
  <p class="vcard-rel" style="margin-top:16px;max-width:860px;"><span>Relationship to DNY infrastructure:</span> {v.relation}</p>
</PageHero>

<Fragment set:html={body} />

<section class="section" aria-labelledby="help-h">
  <div class="container split">
    <div class="reveal-l">
      <span class="kicker">Work with us</span>
      <h2 class="h2-sm" id="help-h">Help build {v.name}</h2>
      <p class="lead" style="margin-top:10px;">One-person companies and Forward Deployed Entrepreneurs can work on {v.name} remotely through the ANZ OPC + FDE Alliance.</p>
      <div class="hero-actions" style="margin-top:18px;">
        <a href={`/opc-fde/join?venture=${v.slug}`} class="btn btn-primary">Express Interest</a>
        <a href="/opc-fde#needs" class="btn btn-secondary">See Open Needs</a>
      </div>
    </div>
    <div class="reveal-r">
      <div class="sep-box">
        <h4>{v.category}</h4>
        <p>Work areas: {v.capabilities.slice(0, 4).join(' · ')}. Specific work packages are scoped with shortlisted members and agreed in a project agreement with DNY.</p>
      </div>
    </div>
  </div>
</section>

{FAQS[v.slug] && <FAQ groups={[v.slug]} title={FAQS[v.slug].title} />}

{related.length > 0 && (
  <section class="section dark" aria-labelledby="rel-h">
    <div class="container">
      <SectionHead kicker="Related" id="rel-h" title="Related ventures" />
      <div class="vgrid reveal">{related.map((r) => <VentureCard v={r} />)}</div>
    </div>
  </section>
)}

<CTABand title={`Interested in ${v.name}?`} lead="Partners, customers and investors can request a briefing." primary={CTA.partner} secondary={CTA.brief} />
</Base>
